            </div>

            <div className="space-y-1.5">
              <div className="font-bold text-slate-800 text-xs uppercase tracking-wider">
                Target Products:
              </div>
              <div className="flex flex-wrap gap-1.5">
                {selectedStandard.productKeywords.map((kw, i) => (
