      {/* Desktop Unified Navigation Strip */}
      <div className="hidden lg:block bg-bis-900 text-white border-t border-bis-800">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-1">
